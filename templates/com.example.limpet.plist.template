<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.limpet</string>
  <key>ProgramArguments</key>
  <array>
    <string>PYTHON</string>
    <string>-m</string>
    <string>limpet.main</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Retry failed connections and invalid configurations every 10 seconds.
       Fix and test configuration in the foreground before loading this agent. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/limpet.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/limpet.log</string>
</dict>
</plist>
